{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Limites": { "PorSegundo": 100, "Rajada": 200 },
  "ReverseProxy": {
    "Routes": {
      "consolidado-saldo": {
        "ClusterId": "consolidado",
        "Order": 1,
        "RateLimiterPolicy": "por-cliente",
        "Match": { "Path": "/contas/{contaId}/saldo" }
      },
      "consolidado-diario": {
        "ClusterId": "consolidado",
        "Order": 1,
        "RateLimiterPolicy": "por-cliente",
        "Match": { "Path": "/contas/{contaId}/consolidado/{**dia}" }
      },
      "lancamentos": {
        "ClusterId": "lancamentos",
        "Order": 10,
        "RateLimiterPolicy": "por-cliente",
        "Match": { "Path": "/contas/{**resto}" }
      }
    },
    "Clusters": {
      "lancamentos": {
        "HttpRequest": { "ActivityTimeout": "00:00:10" },
        "Destinations": { "principal": { "Address": "http://localhost:5101/" } }
      },
      "consolidado": {
        "HttpRequest": { "ActivityTimeout": "00:00:10" },
        "Destinations": { "principal": { "Address": "http://localhost:5102/" } }
      }
    }
  }
}
